rules_version = '2';

/**
 * Firestore security rules.
 *
 * WHY THIS FILE EXISTS
 * --------------------
 * These rules were previously not in the repo at all — they lived only in the
 * Firebase console, so they could not be reviewed, diffed, or deployed with the
 * code. That matters more than usual here, because several collections are
 * written DIRECTLY FROM THE BROWSER with the client SDK:
 *
 *   testimonies  - public submits; admin verifies/rejects (testimonyService.ts)
 *   devotionals  - admin creates/updates/deletes  (devotionals.ts)
 *   live-chat    - public posts messages          (liveChatService.ts)
 *
 * Those paths never touch an API route, so `requireAuth()` on the server does
 * NOT protect them. These rules are the only boundary. If the console is still
 * in test mode (`allow read, write: if true`), anyone can read, alter or wipe
 * every testimony and devotional regardless of any server-side auth.
 *
 * Collections reached only via the Admin SDK (quiz_questions, schedule) are
 * denied to clients outright — the Admin SDK bypasses these rules, so locking
 * them down costs the server nothing.
 *
 * ⚠️ NOT YET VERIFIED AGAINST PRODUCTION. Test with the emulator or the console
 * Rules Playground before deploying:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Only administrators hold real Firebase Auth accounts. Live chat signs
     * visitors in ANONYMOUSLY (to rate-limit posting, see below), so a
     * signed-in request is an admin only when its provider isn't
     * "anonymous". The server applies the same rule to API tokens
     * (lib/auth.ts).
     *
     * If public accounts are ever introduced, this MUST become a custom-claim
     * check (request.auth.token.admin == true).
     */
    function isAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── Testimonies ─────────────────────────────────────────────────────────
    // Public may submit and may read only verified+public entries (the client
    // query filters on exactly these fields). Admins read all and moderate.
    match /testimonies/{testimonyId} {
      allow read: if isAdmin()
                  || (resource.data.status == 'verified'
                      && resource.data.displayPreference == 'public');

      // A submission may only ever arrive as 'pending' — nobody can self-verify
      // — with exactly the fields testimonyService.submitTestimony writes and
      // within the form's limits, so the collection can't be stuffed with
      // arbitrary or oversized documents.
      allow create: if isValidTestimony(request.resource.data);

      allow update, delete: if isAdmin();
    }

    function isValidTestimony(d) {
      return d.keys().hasOnly(['name', 'location', 'phone', 'email', 'testimony',
                               'displayPreference', 'status', 'createdAt'])
          && d.keys().hasAll(['name', 'location', 'phone', 'email', 'testimony',
                              'displayPreference', 'status', 'createdAt'])
          && d.status == 'pending'
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
          && d.location is string && d.location.size() >= 2 && d.location.size() <= 100
          && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 30
          && d.email is string && d.email.size() <= 254 && d.email.matches('.+@.+[.].+')
          && d.testimony is string && d.testimony.size() >= 20 && d.testimony.size() <= 5000
          && d.displayPreference in ['public', 'private']
          && d.createdAt is int
          && d.createdAt > request.time.toMillis() - 120000
          && d.createdAt < request.time.toMillis() + 120000;
    }

    // ── Devotionals ─────────────────────────────────────────────────────────
    // Publicly readable (the PDFs are public anyway); admin-only writes.
    match /devotionals/{devotionalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Live chat ───────────────────────────────────────────────────────────
    // Public read + post; only admins may edit or remove messages.
    //
    // A post must have exactly the fields liveChatService.sendChatMessage
    // writes, within the UI's limits (name ≤ 30 chars in the UI, message ≤
    // 500), and a timestamp of "now". That last check matters: the chat shows
    // messages with timestamp >= the service start, so a future timestamp
    // would let a message reappear in later services.
    //
    // Spam protection: every poster is signed in (anonymously, in the
    // background) and each message must be written in the same batch as the
    // poster's live-chat-throttle stamp, which can only advance 3 seconds
    // after the previous one. So one sign-in can post at most once every
    // 3 seconds, and every message records who sent it (uid) for moderation.
    match /live-chat/{messageId} {
      allow read: if true;
      allow create: if isValidChatMessage(request.resource.data)
          && isThrottledChatPost();
      allow update, delete: if isAdmin();
    }

    match /live-chat-throttle/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastAt'])
          && request.resource.data.lastAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastAt'])
          && request.resource.data.lastAt == request.time
          && request.time > resource.data.lastAt + duration.value(3, 's');
      allow delete: if isAdmin();
    }

    // The message's uid is the poster's, and this same write moved their
    // throttle stamp to now (which the rule above only allows every 3 s).
    function isThrottledChatPost() {
      return request.auth != null
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/live-chat-throttle/$(request.auth.uid)).data.lastAt == request.time;
    }

    function isValidChatMessage(d) {
      return d.keys().hasOnly(['name', 'message', 'timestamp', 'color', 'uid'])
          && d.keys().hasAll(['name', 'message', 'timestamp', 'color', 'uid'])
          && d.uid is string
          && d.name is string && d.name.size() > 0 && d.name.size() <= 50
          && d.message is string && d.message.size() > 0 && d.message.size() <= 500
          && d.color is string && d.color.size() <= 16
          && d.timestamp is int
          && d.timestamp > request.time.toMillis() - 120000
          && d.timestamp < request.time.toMillis() + 120000;
    }

    // ── Server-only collections ─────────────────────────────────────────────
    // Reached exclusively through the Admin SDK, which bypasses these rules.
    // quiz_questions in particular holds the CORRECT ANSWERS.
    match /quiz_questions/{questionId} {
      allow read, write: if false;
    }

    // The audit log is append-only from the server (lib/auditLog.ts) and is
    // read back through /api/admin/audit-log. Denying clients outright is the
    // point: an admin who could write here could forge entries, and one who
    // could delete here could erase their own trail. The Admin SDK bypasses
    // these rules, so the server is unaffected.
    match /admin_audit_logs/{entryId} {
      allow read, write: if false;
    }

    // House fellowship centers are read through /api/fellowship (public GET)
    // and written only by the admin API with a verified token, both via the
    // Admin SDK — so, like the schedule collections, clients get nothing.
    match /fellowship_centers/{centerId} {
      allow read, write: if false;
    }

    // ── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
