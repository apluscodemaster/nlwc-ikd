{
  "name": "nlwc-ikd-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:shared": "node scripts/check-shared-imports.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:shared && npm test",
    "doctor": "npx expo-doctor",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "icons": "node scripts/gen-icons.mjs",
    "brand-assets": "node scripts/make-brand-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jost": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.108.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "firebase": "^12.9.0",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.8.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.14.0",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/src/$1",
      "^@web/(.*)$": "<rootDir>/../src/$1",
      "^@/(.*)$": "<rootDir>/../src/$1"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|lucide-react-native))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "transform": {
      "\\.mjs$": "<rootDir>/scripts/jest-mjs-transform.js"
    }
  },
  "expo": {
    "install": {
      "exclude": []
    }
  }
}
