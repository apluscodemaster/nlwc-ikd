{
  "name": "nlwc-ikd-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:shared": "node scripts/check-shared-imports.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:shared && npm test",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/jost": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
