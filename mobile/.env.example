# Copy to .env and fill in. Every EXPO_PUBLIC_* value is bundled into the
# app and is public by design: never put server secrets here.

# Next.js API origin (the website). For a local web server use your LAN IP,
# e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=https://ikorodu.nlwc.church

# Firebase client config: same values as the web's NEXT_PUBLIC_FIREBASE_*.
# Used for live chat and the testimonies feed (Firestore realtime).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public site used for share links
EXPO_PUBLIC_SITE_URL=https://ikorodu.nlwc.church
