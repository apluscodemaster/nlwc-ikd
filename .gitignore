# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#API
/src/app/api/sheet/.env.local
/src/app/api/sheet/.env.development

# WordPress mu-plugins (server-side, contains DB schema details).
# Deployed by hand to wp-content/mu-plugins/ — keep local copies.
/wordpress/

# Supabase migrations (DB schema + table layouts).
# Run by hand in the Supabase SQL editor — keep local copies.
/supabase/

# Documentation & Setup Guides (local reference only)
WEBHOOK_SETUP.md
WORDPRESS_INTEGRATION.md
# Architecture reference — kept local; it names internal hosts, table
# layouts and known gaps that don't belong in the pushed repo.
/docs/
# Claude Code: machine-local permissions/settings (never commit — the
# auto-approved allowlist churns per session and conflicts on every merge)
.claude/settings.local.json
