# Copy to .env.local and fill in. Every variable the web app reads is listed
# here; never commit real values. On Netlify, set the same names under
# Site configuration → Environment variables (Netlify reserves AWS_*, hence S3_*).
# Variables starting NEXT_PUBLIC_ are built into the browser bundle: public by design.

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ikorodu.nlwc.church
NEXT_PUBLIC_WORDPRESS_URL=https://ikdadmin.nlwc.church
# WordPress application password (Users → Profile → Application Passwords), for publishing from the admin
WP_APPLICATION_USER=
WP_APPLICATION_PASSWORD=
# Shared secret WordPress sends to /api/revalidate
WEBHOOK_SECRET=

# ── Firebase (client: public) ─────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (server: secret; a service account) ────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes, in double quotes
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Google Sheets (gallery, video messages, live stream link) ─────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_NAME=church_gallery
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── YouTube / live ────────────────────────────────────────────────────────────
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
# Server key for live status (videos.list); restrict it to the YouTube Data API
YOUTUBE_API_KEY=
NEXT_PUBLIC_WAYSTREAM_EMBED_URL=

# ── Media storage ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3: devotional PDFs (Daily_Devotionals/). AWS_S3_BUCKET / AWS_S3_REGION are older fallbacks.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nlwc-ikorodu
S3_REGION=us-east-2
AWS_S3_BUCKET=
AWS_S3_REGION=
# CloudFront (or other CDN) in front of the sermon audio, e.g. https://dxxxx.cloudfront.net
NEXT_PUBLIC_AUDIO_CDN_URL=

# ── Quiz (Supabase) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret mixed into security-answer hashes; never change once set
QUIZ_SECURITY_PEPPER=

# ── Bible search ──────────────────────────────────────────────────────────────
BIBLE_API_BASE=
BIBLE_API_BIBLE_ID=
BIBLE_API_KEY=

# ── Forms: Turnstile spam check and email ─────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=465
CHURCH_EMAIL_ADDRESS=
CHURCH_EMAIL_PASSWORD=
# Comma-separated addresses told about new testimonies
TESTIMONY_NOTIFY_EMAILS=

# ── Web push (generate with: node scripts/generate-vapid-keys.mjs) ────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ikoroduchurchadmin@nlwc.church

# ── Scheduled jobs (also a GitHub Actions secret with the same value) ─────────
CRON_SECRET=

# ── Shared rate limits (optional; in-memory per instance without them) ───────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV names for the same Upstash store
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Scripts only ──────────────────────────────────────────────────────────────
# Which env file scripts/*.ts read (default .env.local)
ENV_FILE=
